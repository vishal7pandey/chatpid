# === LLM Provider Selection ===
# Switch between providers without code changes — just update this + the
# model/key below and restart.
LLM_PROVIDER=groq  # groq | gemini

# --- Groq (OpenAI-compatible) ---
GROQ_API_KEY=
CHATPID_CHAT_MODEL=llama-3.3-70b-versatile
CHATPID_LLM_BASE_URL=https://api.groq.com/openai/v1

# --- Google Gemini ---
GOOGLE_API_KEY=
# When LLM_PROVIDER=gemini, set CHATPID_CHAT_MODEL to a Gemini model:
#   gemini-2.5-flash | gemini-2.5-pro | gemini-2.0-flash

# Embedding model for VectorRAG / PathRAG (local HuggingFace, no API key needed)
CHATPID_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=chatpid_dev_pw
