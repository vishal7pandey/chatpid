GROQ_API_KEY=

# Chat model used by the ChatP&ID agent (Groq, OpenAI-compatible API)
CHATPID_CHAT_MODEL=llama-3.3-70b-versatile
# LLM base URL (Groq's OpenAI-compatible endpoint)
CHATPID_LLM_BASE_URL=https://api.groq.com/openai/v1
# Embedding model for VectorRAG / PathRAG (local HuggingFace, no API key needed)
CHATPID_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=chatpid_dev_pw
