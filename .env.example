CHATPID_CHAT_MODEL=gpt-5-mini
# Embedding model used for VectorRAG / PathRAG node embeddings
CHATPID_EMBEDDING_MODEL=text-embedding-3-small

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=chatpid_dev_pw
